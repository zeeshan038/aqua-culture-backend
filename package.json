{
  "name": "aquaculture-gateway",
  "version": "1.0.0",
  "description": "SCADA-like water quality monitoring backend for aquaculture",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "server": "nodemon index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "keywords": ["aquaculture", "scada", "modbus", "postgresql", "socket.io"],
  "author": "Marcel",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "modbus-serial": "^8.0.16",
    "resend": "^3.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.8.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
